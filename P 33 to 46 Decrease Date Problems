// P 33 to 46 Decrease Date Problems

#include <iostream>

using namespace std;
struct sDate {
    short Day;
    short Month;
    short Year;
};
bool IsLeapYear(short Year)
{
    return (Year % 4 == 0 && Year % 100 != 0) || (Year % 400 == 0);


}
short NumberofDaysInAMonth(short Month, short Year)
{
    if (Month < 1 || Month>12)
    {
        return 0;
    }

    short NumberOfDays[12] = { 31,28,31,30,31,30,31,31,30,31,30,31 };
    return (Month == 2) ? (IsLeapYear(Year) ? 29 : 28) :
        NumberOfDays[Month - 1];


}
bool IsFirstDay(sDate Date)
{
    return (Date.Day == 1);
}
bool IsFirsMonth(short Month)
{
    return (Month == 1);
}
sDate DecreaseDateByOneDay(sDate Date)
{
    if (IsFirstDay(Date))
    {
        if (IsFirsMonth(Date.Month))
        {
            Date.Year--;
            Date.Month = 1;
            Date.Day = 1;
            
           
        }
        else
        {
            Date.Month--;
            Date.Day = NumberofDaysInAMonth(Date.Month, Date.Year);
           
        }
    }
    else
    {
        Date.Day--;
    }

    return Date;


}

short ReadDay()
{
    short Day = 0;
    cout << "\nPleas Entar a Day? ";
    cin >> Day;
    return Day;
}
short ReadMonth()
{
    short Month;
    do
    {
        cout << "Pleas Entar a Month? ";
        cin >> Month;
    } while (Month < 1 || Month > 12);


    return Month;
}
short ReadYear()
{
    short year;
    do
    {
        cout << "Pleas Entar a Year Between [1900 ] To [2200]? ";
        cin >> year;
    } while (year < 1900 || year > 2200);


    return year;
}
sDate ReadFullDays()
{
    sDate Date;
    Date.Day = ReadDay();
    Date.Month = ReadMonth();
    Date.Year = ReadYear();
    return Date;
}

sDate DecreaseDateByXDays(short Day, sDate Date)
{
    for (short i = 1; i <= Day; i++)
    {
        Date = DecreaseDateByOneDay(Date);
    }
    return Date;
}
sDate DecreaseDateByOneWeek(sDate Date)
{
    for (short i = 1; i <= 7; i++)
    {
        Date = DecreaseDateByOneDay(Date);
    }
    return Date;
}
sDate DecreaseDateByXWeeks(short Weeks, sDate Date)
{
    for (short i = 1; i <= Weeks; i++)
    {
        Date = DecreaseDateByOneWeek(Date);
    }
    return Date;
}
sDate DecreaseDateByOneMonth(sDate Date)
{
    if (IsFirsMonth(Date.Month))
    {
        Date.Month = 1;
        Date.Year--;
    }
    else
    {
        Date.Month--;
        short NumberOfDaysInCurrentMonth =
            NumberofDaysInAMonth(Date.Month, Date.Year);
        if (Date.Day > NumberOfDaysInCurrentMonth)
            Date.Day = NumberOfDaysInCurrentMonth;
    }
    return Date;
}

sDate DecreaseDateByXMonths(short Months, sDate Date)
{

    for (short i = 1; i <= Months; i++)
    {
        Date = DecreaseDateByOneMonth(Date);
    }
    return Date;
}
sDate DecreaseDateByOneYear(sDate Date)
{
    Date.Year--;
    return Date;
}
sDate DecreaseDateByXYears(short Years, sDate Date)
{
    for (short i = 1; i <= Years; i++)
    {
        Date = DecreaseDateByOneYear(Date);
    }
    return Date;
}
sDate DecreaseDateByXYearsFaster(short Years, sDate Date)
{
    Date.Year -= Years;
    return Date;
}

sDate DecreaseDateByOneDecade(sDate Date)
{
    for (short i = 1; i <= 10; i++)
    {
        Date = DecreaseDateByOneYear(Date);
    }
    return Date;
}

sDate DecreaseDateByXDecades(short Decades, sDate Date)
{
    for (short i = 1; i <= 10 * Decades; i++)
    {
        Date = DecreaseDateByOneYear(Date);
    }
    return Date;
}

sDate DecreaseDateByXDecadesFaster(short Decades, sDate Date)
{
    Date.Year -= 10 * Decades;
    return Date;
}

sDate DecreaseDateByOneCentury(sDate Date)
{

    Date.Year -= 100;
    return Date;
}

sDate DecreaseDateByOneMillennium(sDate Date)
{
    Date.Year -= 1000;
    return Date;
}

int main()
{

    sDate Date = ReadFullDays();

    cout << "Date After :\n\n";
    Date = DecreaseDateByOneDay(Date);
    cout << "\nAdding One Days Is: "
        << Date.Day << "/" << Date.Month << "/" << Date.Year;

    Date = DecreaseDateByXDays(10, Date);
    cout << "\nAdding 10 Days Is: ";
    cout << Date.Day << "/" << Date.Month << "/" << Date.Year;

    Date = DecreaseDateByOneWeek(Date);
    cout << "\nAdding One Week Days Is: ";
    cout << Date.Day << "/" << Date.Month << "/" << Date.Year;

    Date = DecreaseDateByXWeeks(10, Date);
    cout << "\nAdding 10 Week Days Is: ";
    cout << Date.Day << "/" << Date.Month << "/" << Date.Year;


    Date = DecreaseDateByOneMonth(Date);
    cout << "\nAdding One Month Days Is: ";
    cout << Date.Day << "/" << Date.Month << "/" << Date.Year;


    Date = DecreaseDateByXMonths(5, Date);
    cout << "\nAdding 10 Month Days Is: ";
    cout << Date.Day << "/" << Date.Month << "/" << Date.Year;


    Date = DecreaseDateByOneYear(Date);
    cout << "\nAdding One Century Days Is: ";
    cout << Date.Day << "/" << Date.Month << "/" << Date.Year;


    Date = DecreaseDateByXYears(10, Date);
    cout << "\nAdding 10 Year Day Is: ";
    cout << Date.Day << "/" << Date.Month << "/" << Date.Year;

    Date = DecreaseDateByXYearsFaster(10, Date);
    cout << "\nAdding 10 Year (Faster) Day Is: ";
    cout << Date.Day << "/" << Date.Month << "/" << Date.Year;

    Date = DecreaseDateByOneDecade(Date);
    cout << "\nAdding One Decade  Day Is: ";
    cout << Date.Day << "/" << Date.Month << "/" << Date.Year;

    Date = DecreaseDateByXDecades(10, Date);
    cout << "\nAdding 10 Decade Days Is: ";
    cout << Date.Day << "/" << Date.Month << "/" << Date.Year;


    Date = DecreaseDateByXDecadesFaster(10, Date);
    cout << "\nAdding 10 Decade (Faster) Days Is: ";
    cout << Date.Day << "/" << Date.Month << "/" << Date.Year;

    Date = DecreaseDateByOneCentury(Date);
    cout << "\nAdding One Century Days Is: ";
    cout << Date.Day << "/" << Date.Month << "/" << Date.Year;

    Date = DecreaseDateByOneMillennium(Date);
    cout << "\nAdding One Millennium Days Is: ";
    cout << Date.Day << "/" << Date.Month << "/" << Date.Year;


    system("pause>0");
    return 0;
}
