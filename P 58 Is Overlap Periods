// P 58 Is Overlap Periods
#include <iostream>
#include <vector>

using namespace std;
struct stDate {
    short Day;
    short Month;
    short Year;
};
struct stPeriods {
    stDate Start;
    stDate End;
};
enum enCompare
{
    Before = -1, Equal = 0, After = 1
};

short ReadDay()
{
    short Day = 0;
    cout << "\nPleas Entar a Day? ";
    cin >> Day;
    return Day;
}
short ReadMonth()
{
    short Month;
    do
    {
        cout << "Pleas Entar a Month? ";
        cin >> Month;
    } while (Month < 1 || Month > 12);


    return Month;
}
short ReadYear()
{
    short year;
    do
    {
        cout << "Pleas Entar a Year Between [1900 ] To [2200]? ";
        cin >> year;
    } while (year < 1900 || year > 2200);


    return year;
}
stDate ReadFullDays()
{
    stDate Date;
    Date.Day = ReadDay();
    Date.Month = ReadMonth();
    Date.Year = ReadYear();
    return Date;
}
stPeriods ReadPeriods() 
{
    stPeriods Periods;
    cout << "\nEnter Start Date:\n";
    Periods.Start = ReadFullDays();
    cout << "\nEnter End Date:\n";
    Periods.End = ReadFullDays();
    return Periods;
}

bool IsDate1BeforeDate2(stDate Date1, stDate Date2)
{
    return (Date1.Year < Date2.Year) ? true : ((Date1.Year ==
        Date2.Year) ? (Date1.Month < Date2.Month ? true : (Date1.Month ==
            Date2.Month ? Date1.Day < Date2.Day : false)) : false);
}
bool IsDate1EqualDate2(stDate Date1, stDate Date2)
{
    return (Date1.Year == Date2.Year) ? ((Date1.Month ==
        Date2.Month) ? ((Date1.Day == Date2.Day) ? true : false) : false)
        : false;
}
enCompare CompareDate(stDate Date1, stDate Date2)
{
    if (IsDate1BeforeDate2(Date1, Date2))
        return  enCompare::Before;
    if (IsDate1EqualDate2(Date1, Date2))
        return  enCompare::Equal;
    return  enCompare::After;
}

bool ISOverlapone(stPeriods Periods1, stPeriods Periods2)
{
    if (CompareDate(Periods1.Start, Periods2.End) == enCompare::After 
        ||
        CompareDate(Periods1.End, Periods2.Start) == enCompare::Before)
        return false;
    else
        return true;
           
}
int main()
{

    cout << "Entar Periods1: ";
    stPeriods Periods1 = ReadPeriods();

    cout << "\nEntar Periods2: ";
    stPeriods Periods2 = ReadPeriods();

    
    if (ISOverlapone(Periods1, Periods2))
        cout << "\nYes, Periods Overlap\n";
    else 
        cout << "\nNo, Periods do not Overlap\n";

    system("pause>0");
    return 0;
}


