sDate ReadFullDays() 
{
    sDate Date;
    Date.Day = ReadDay();
    Date.Month = ReadMonth();
    Date.Year = ReadAddDay();
    return Date;
}
int main()
{
    
    sDate Date = ReadFullDays();
    short AddDays = ReadAddDay();

    Date = DateAddDays(AddDays, Date);
