// P 61 Count Overlap Days


#include <iostream>

using namespace std;
struct stDate {
    short Day;
    short Month;
    short Year;
};
struct stPeriods {
    stDate Start;
    stDate End;
};
enum enCompare
{
    Before = -1, Equal = 0, After = 1
};

short ReadDay()
{
    short Day = 0;
    cout << "\nPleas Entar a Day? ";
    cin >> Day;
    return Day;
}
short ReadMonth()
{
    short Month;
    do
    {
        cout << "Pleas Entar a Month? ";
        cin >> Month;
    } while (Month < 1 || Month > 12);


    return Month;
}
short ReadYear()
{
    short year;
    do
    {
        cout << "Pleas Entar a Year Between [1900 ] To [2200]? ";
        cin >> year;
    } while (year < 1900 || year > 2200);


    return year;
}
stDate ReadFullDays()
{
    stDate Date;
    Date.Day = ReadDay();
    Date.Month = ReadMonth();
    Date.Year = ReadYear();
    return Date;
}
stPeriods ReadPeriods()
{
    stPeriods Periods;
    cout << "\nEnter Start Date:\n";
    Periods.Start = ReadFullDays();
    cout << "\nEnter End Date:\n";
    Periods.End = ReadFullDays();
    return Periods;
}

bool IsLeapYear(short Year)
{
    return (Year % 4 == 0 && Year % 100 != 0) || (Year % 400 == 0);


}
short NumberofDaysInAMonth(short Month, short Year)
{
    if (Month < 1 || Month>12)
    {
        return 0;
    }

    short NumberOfDays[12] = { 31,28,31,30,31,30,31,31,30,31,30,31 };
    return (Month == 2) ? (IsLeapYear(Year) ? 29 : 28) :
        NumberOfDays[Month - 1];


}
bool IsLsatDay(stDate Date)
{
    return (Date.Day == NumberofDaysInAMonth(Date.Month, Date.Year));
}
bool IsLastMonth(short Month)
{
    return (Month == 12);
}
stDate IncreaseDateByOneDay(stDate Date)
{
    if (IsLsatDay(Date))
    {
        if (IsLastMonth(Date.Month))
        {
            Date.Day = 1;
            Date.Month = 1;
            Date.Year++;
        }
        else
        {
            Date.Day = 1;
            Date.Month++;
        }
    }
    else
    {
        Date.Day++;
    }

    return Date;


}

bool IsDate1BeforeDate2(stDate Date1, stDate Date2)
{
    return (Date1.Year < Date2.Year) ? true : ((Date1.Year ==
        Date2.Year) ? (Date1.Month < Date2.Month ? true : (Date1.Month ==
            Date2.Month ? Date1.Day < Date2.Day : false)) : false);
}
bool IsDate1EqualDate2(stDate Date1, stDate Date2)
{
    return (Date1.Year == Date2.Year) ? ((Date1.Month ==
        Date2.Month) ? ((Date1.Day == Date2.Day) ? true : false) : false)
        : false;
}

enCompare CompareDate(stDate Date1, stDate Date2)
{
    if (IsDate1BeforeDate2(Date1, Date2))
        return  enCompare::Before;
    if (IsDate1EqualDate2(Date1, Date2))
        return  enCompare::Equal;
    return  enCompare::After;
}
bool IsOverlapPeriods(stPeriods Periods1, stPeriods Periods2)
{
    if (CompareDate(Periods1.Start, Periods2.End) == enCompare::After
        ||
        CompareDate(Periods1.End, Periods2.Start) == enCompare::Before)
        return false;
    else
        return true;

}
bool IsDateInPeriod(stPeriods Periods, stDate Date)
{
    return !(CompareDate(Date, Periods.Start) == enCompare::Before
        ||
        CompareDate(Date, Periods.End) == enCompare::After);
}

int GetDifferenceInDays(stDate Date1, stDate Date2, bool
    IncludeEndDay = false)
{
    int Days = 0;
    while (IsDate1BeforeDate2(Date1, Date2))
    {
        Days++;
        Date1 = IncreaseDateByOneDay(Date1);
    }
    return IncludeEndDay ? ++Days : Days;
}
int PeriodLengthInDay(stPeriods Periods, bool  IncludeEndDay = false)
{

    return GetDifferenceInDays(Periods.Start, Periods.End, IncludeEndDay);
}


int CountOverlapDays(stPeriods Periods1, stPeriods Periods2)
{
    int Period1Length = PeriodLengthInDay(Periods1, true);
    int Period2Length = PeriodLengthInDay(Periods2, true);
    int OverlapDays = 0;

    if (!IsOverlapPeriods(Periods1, Periods2))
        return 0;

    if (Period1Length< Period2Length) 
    {
        while (IsDate1BeforeDate2(Periods1.Start, Periods1.End))
        {
            if (IsDateInPeriod(Periods2, Periods1.Start))
                OverlapDays++;
            Periods1.Start = IncreaseDateByOneDay(Periods1.Start);
        }
    }
    else
    {
        while (IsDate1BeforeDate2(Periods2.Start, Periods2.End))
        {
            if (IsDateInPeriod(Periods1, Periods2.Start))
                OverlapDays++;
            Periods2.Start = IncreaseDateByOneDay(Periods2.Start);
        }
    }
    

    return  OverlapDays;
}
int main()
{

    cout << "\nEntar Periods1: ";
    stPeriods Periods1 = ReadPeriods();

    cout << "\nEntar Periods1: ";
    stPeriods Periods2 = ReadPeriods();

    cout << "\nOverlap Days Count Is: " <<
        CountOverlapDays(Periods1, Periods2);

    system("pause>0");
    return 0;
}


