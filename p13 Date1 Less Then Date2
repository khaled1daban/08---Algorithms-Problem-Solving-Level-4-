// p13 Date1 Less Then Date2

#include <iostream>

using namespace std;
struct sDate {
    short Day;
    short Month;
    short Year;
};
bool IsDate1LessThenDate2(sDate Date1, sDate Date2)
{
    return (Date1.Year < Date2.Year) ? true : ((Date1.Year == Date2.Year) ?
        (Date1.Month < Date2.Month ? true : (Date1.Month == Date2.Month ?
            Date1.Day < Date2.Day : false)) : false);

}

short ReadDay()
{
    short Day = 0;
    cout << "\nPleas Entar a Day? ";
    cin >> Day;
    return Day;
}
short ReadMonth()
{
    short Month;
    do
    {
        cout << "Pleas Entar a Month? ";
        cin >> Month;
    } while (Month < 1 || Month > 12);


    return Month;
}
short ReadYear()
{
    short year;
    do
    {
        cout << "Pleas Entar a Year Between [1900 ] To [2200]? ";
        cin >> year;
    } while (year < 1900 || year > 2200);


    return year;
}

sDate ReadFullDays()
{
    sDate Date;
    Date.Day = ReadDay();
    Date.Month = ReadMonth();
    Date.Year = ReadYear();
    return Date;
}
int main()
{

    sDate Date1 = ReadFullDays();

    sDate Date2 = ReadFullDays();


    if (IsDate1LessThenDate2(Date1, Date2))
    {
        cout << "\nYes,Date1 Less Then Date2. \n";
    }
    else
        cout << "\nNo,Date1 Less Then Date2. \n";

    

    
   



