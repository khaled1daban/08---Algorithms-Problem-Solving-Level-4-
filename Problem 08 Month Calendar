// Problem 08 Month Calendar

#include <iostream>
using namespace std;
short ReadMonth()
{
    short Month;
    do
    {
        cout << "Pleas Entar a Month? ";
        cin >> Month;
    } while (Month < 1 || Month > 12);


    return Month;
}
short ReadYear()
{
    short year;
    do
    {
        cout << "Pleas Entar a Year Between [1900 ] To [2200]? ";
        cin >> year;
    } while (year < 1900 || year > 2200);


    return year;
}
bool IsLeapYear(short Year)
{
    return (Year % 4 == 0 && Year % 100 != 0) || (Year % 400 == 0);


}
short NumberofDaysInAMonth(short Month, short Year)
{
    if (Month < 1 || Month>12)
    {
        return 0;
    }

    short NumberOfDays[12] = { 31,28,31,30,31,30,31,31,30,31,30,31 };
    return (Month == 2) ? (IsLeapYear(Year) ? 29 : 28) :
        NumberOfDays[Month - 1];


}

int DayOfWeekOrder(short Day, short Month, short Year)
{

    int a = (14 - Month) / 12;
    int y = Year - a;
    int m = Month + (12 * a) - 2;

    return  (Day + y + (y / 4) - (y / 100) + (y / 400) +
        ((31 * m) / 12)) % 7;


}
string DaysShortName(int DayOfWeekOrder)
{
    string DaysOfWeek[7] = {
        "Sun","Mon","Tue","Wed","Thu","Fri","Sat" };
    return DaysOfWeek[DayOfWeekOrder];
}
string MonthShortName(short number)
{
    string Month[12]{ "Jan", "Feb", "Mar","Apr", "May",
"Jun" ,"Jul", "Aug", "Sep","Oct", "Nov", "Dec" };
    return Month[number - 1];
}
void PrintMonthCalender(short Month, short Year)
{
    int current = DayOfWeekOrder(1, Month, Year);
    int NumberOfDay = NumberofDaysInAMonth(Month, Year);
    printf("\n _______________%s_______________\n\n",
        MonthShortName(Month).c_str());

    printf("  Sun  Mon  Tue  Wed  Thu  Fri  Sat\n");

    int i;
    for (i = 0 ; i < current ; i++)
    {
        printf("     ");
    }
    for (int j = 1 ; j <= NumberOfDay ; j++)
    {
        printf("%5d", j);
        if (++i == 7)
        {
            i = 0;
            printf("\n");
            
        }
            
    }
    printf("\n _________________________________\n");
}
int main()
{
    int Month = ReadMonth();
    int Year = ReadYear();

    PrintMonthCalender(Month, Year);

    system("pause>0");
    return 0;
}


